{
  "name": "@autocars/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "admin": "tsx --env-file-if-exists=../../.env src/admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test tsx --test test/*.test.ts",
    "backup": "tsx --env-file-if-exists=../../.env src/backup.ts"
  },
  "dependencies": {
    "@autocars/core": "1.0.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.11",
    "@fastify/websocket": "^11.3.7",
    "fastify": "^5.6.2",
    "nodemailer": "^10.5.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.6",
    "web-push": "^3.6.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/nodemailer": "^7.0.3",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1"
  }
}
