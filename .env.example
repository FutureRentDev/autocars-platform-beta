PORT=4000
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173
DATA_DIR=./data
# Set NODE_ENV=production behind HTTPS. Production requires SMTP and explicit origins.
# SMTP_URL=smtps://username:password@mail.example.com:465
# MAIL_FROM=AutoCars <hello@your-domain.co.za>
# Mobile physical devices: use your computer LAN address, not localhost.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
# npm run mobile detects your Mac address automatically when the above is unset.
# AUTOCARS_DEV_HOST=192.168.1.10
# EXPO_PORT=8082
# Optional local email: npm run mail:start, then npm run dev:mail.

# Web push: generate a persistent key pair with npm run setup:push.
# WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=https://autocars.co.za
# Optional enhanced Expo Push Service security token (server only):
# EXPO_ACCESS_TOKEN=
# Native builds: configure these in the EAS environment, never private credentials.
# EXPO_OWNER=
# EXPO_PROJECT_ID=

# Hosted website/PWA checkout: configure your own Payfast merchant account.
# PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_KEY=
# PAYFAST_PASSPHRASE=
# PAYFAST_PUBLIC_ORIGIN=https://your-domain.co.za
# PAYFAST_SANDBOX=true
# Set PAYFAST_SANDBOX=false for real payments after testing notifications.
